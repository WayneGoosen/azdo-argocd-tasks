{
    "manifestVersion": 1,
    "id": "argocd-pipeline-tasks",
    "name": "Argo CD Pipeline Tasks",
    "version": "1.0.0",
    "publisher": "WayneGoosen",
    "description": "Sync, wait on, diff and report Argo CD applications from Azure Pipelines, over the Argo CD REST API. No CLI download required.",
    "public": true,
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "categories": [
        "Azure Pipelines"
    ],
    "tags": [
        "argocd",
        "argo cd",
        "gitops",
        "kubernetes",
        "deployment",
        "continuous delivery",
        "helm",
        "kustomize"
    ],
    "icons": {
        "default": "images/extension-icon.png"
    },
    "content": {
        "details": {
            "path": "marketplace/overview.md"
        }
    },
    "links": {
        "repository": {
            "uri": "https://github.com/WayneGoosen/azdo-argocd-tasks"
        },
        "issues": {
            "uri": "https://github.com/WayneGoosen/azdo-argocd-tasks/issues"
        },
        "support": {
            "uri": "https://github.com/WayneGoosen/azdo-argocd-tasks/issues"
        },
        "license": {
            "uri": "https://github.com/WayneGoosen/azdo-argocd-tasks/blob/main/LICENSE"
        }
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/WayneGoosen/azdo-argocd-tasks"
    },
    "branding": {
        "color": "rgb(239, 122, 63)",
        "theme": "light"
    },
    "files": [
        {
            "path": "dist/tasks/ArgoCDAppV1"
        },
        {
            "path": "dist/tasks/ArgoCDInstallV1"
        },
        {
            "path": "dist/tasks/ArgoCDCliV1"
        },
        {
            "path": "dist/tasks/ArgoCDProjectV1"
        },
        {
            "path": "dist/tasks/ArgoCDAccountV1"
        },
        {
            "path": "dist/tasks/ArgoCDAppSetV1"
        },
        {
            "path": "images",
            "addressable": true
        }
    ],
    "contributions": [
        {
            "id": "argocd-service-endpoint",
            "description": "Service connection for an Argo CD server",
            "type": "ms.vss-endpoint.service-endpoint-type",
            "targets": [
                "ms.vss-endpoint.endpoint-types"
            ],
            "properties": {
                "name": "argocdrest",
                "displayName": "Argo CD",
                "url": {
                    "displayName": "Server URL",
                    "helpText": "Base URL of the Argo CD server, for example https://argocd.example.com or https://example.com/argocd"
                },
                "inputDescriptors": [
                    {
                        "id": "caCertificate",
                        "name": "Custom CA certificate (PEM)",
                        "description": "PEM-encoded certificate authority bundle, for an Argo CD server using an internal PKI.",
                        "inputMode": "TextArea",
                        "isConfidential": false,
                        "validation": {
                            "isRequired": false,
                            "dataType": "string"
                        }
                    },
                    {
                        "id": "insecureSkipTlsVerify",
                        "name": "Skip TLS verification",
                        "description": "Set to true to accept any server certificate. Traffic stays encrypted but the server identity is not verified. Prefer a custom CA.",
                        "inputMode": "textbox",
                        "isConfidential": false,
                        "validation": {
                            "isRequired": false,
                            "dataType": "string"
                        }
                    },
                    {
                        "id": "grpcWebRootPath",
                        "name": "Root path",
                        "description": "Sub-path the Argo CD server is served under, for example /argocd. Only needed when it is not served at the domain root.",
                        "inputMode": "textbox",
                        "isConfidential": false,
                        "validation": {
                            "isRequired": false,
                            "dataType": "string"
                        }
                    }
                ],
                "authenticationSchemes": [
                    {
                        "type": "ms.vss-endpoint.endpoint-auth-scheme-token",
                        "headers": [
                            {
                                "name": "Authorization",
                                "value": "Bearer {{endpoint.apitoken}}"
                            }
                        ],
                        "inputDescriptors": [
                            {
                                "id": "apitoken",
                                "name": "API token",
                                "description": "An Argo CD project role token (argocd proj role create-token) or account API token. Project role tokens are preferred: they are scoped to one AppProject and can be revoked individually.",
                                "inputMode": "passwordbox",
                                "isConfidential": true,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            }
                        ]
                    },
                    {
                        "type": "ms.vss-endpoint.endpoint-auth-scheme-none"
                    }
                ],
                "dataSources": [
                    {
                        "name": "TestConnection",
                        "endpointUrl": "{{endpoint.url}}/api/v1/session/userinfo",
                        "resultSelector": "jsonpath:$.loggedIn"
                    }
                ],
                "helpMarkDown": "Create an Argo CD project role token with <code>argocd proj role create-token &lt;project&gt; &lt;role&gt; --expires-in 90d</code>. See the <a href=\"https://waynegoosen.github.io/azdo-argocd-tasks/security/\" target=\"_blank\">security guide</a> for the RBAC policy to grant it."
            }
        },
        {
            "id": "argocd-app-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "dist/tasks/ArgoCDAppV1"
            }
        },
        {
            "id": "argocd-install-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "dist/tasks/ArgoCDInstallV1"
            }
        },
        {
            "id": "argocd-cli-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "dist/tasks/ArgoCDCliV1"
            }
        },
        {
            "id": "argocd-project-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "dist/tasks/ArgoCDProjectV1"
            }
        },
        {
            "id": "argocd-account-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "dist/tasks/ArgoCDAccountV1"
            }
        },
        {
            "id": "argocd-appset-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "dist/tasks/ArgoCDAppSetV1"
            }
        }
    ]
}
