{
    "name": "azdo-argocd-tasks",
    "version": "0.0.0",
    "private": true,
    "description": "Azure DevOps pipeline tasks for Argo CD",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/WayneGoosen/azdo-argocd-tasks"
    },
    "engines": {
        "node": ">=20"
    },
    "workspaces": [
        "packages/*",
        "tasks/*"
    ],
    "scripts": {
        "clean": "rimraf dist *.vsix",
        "typecheck": "tsc --noEmit",
        "typecheck:tab": "tsc --noEmit -p tsconfig.tab.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "build:tasks": "node scripts/build.mjs",
        "build:tab": "webpack --mode production",
        "copy:tab": "copyfiles -f tab/*.html tab/*.css dist/tab/",
        "dev:tab": "npm run build:tab && npm run copy:tab && rimraf .dev && copyfiles -u 2 \"dist/tab/**/*\" .dev/ && copyfiles -u 1 \"dev-fixtures/**/*\" .dev/",
        "dev": "npm run dev:tab && npx --yes http-server .dev -c-1 -p 8777",
        "build": "npm run clean && npm run typecheck && npm run typecheck:tab && npm run build:tasks && npm run build:tab && npm run copy:tab",
        "build:dev": "node scripts/build.mjs --sourcemap",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "package": "npm run build && tfx extension create --manifest-globs vss-extension.json --output-path dist/",
        "package:dev": "npm run build && tfx extension create --manifest-globs vss-extension.json --overrides-file vss-extension.dev.json --output-path dist/",
        "stamp": "node scripts/stamp-version.mjs",
        "swagger:fetch": "node scripts/fetch-swagger.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.19.9",
        "@vitest/coverage-v8": "^3.2.7",
        "azure-devops-extension-api": "^5.279.1",
        "azure-devops-extension-sdk": "^4.2.0",
        "copyfiles": "^2.4.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "globals": "^17.13.0",
        "rimraf": "^6.0.1",
        "tfx-cli": "^0.24.2",
        "ts-loader": "^9.6.2",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^3.0.5",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    }
}
