{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        // node16, not commonjs/node10. TypeScript 6 deprecates moduleResolution=node10
        // (TS5107) and TypeScript 7 removes it. node16 is the accurate model for what these
        // tasks actually are -- CommonJS packages resolved by Node -- and it typechecks
        // clean today on TypeScript 5, so this lands independently of the TS 6 bump.
        // `ignoreDeprecations: "6.0"` is NOT an alternative: TypeScript 5 rejects that value
        // outright (TS5103), so it cannot be applied ahead of the upgrade.
        "module": "node16",
        "moduleResolution": "node16",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node"],

        // esbuild emits the shipped bundles (scripts/build.mjs); tsc is a type checker only.
        // Keeping a single non-emitting project avoids TS project references and the stale-
        // .d.ts problems that come with them for internal-only workspace packages.
        "noEmit": true
    },
    "include": [
        "packages/**/src/**/*.ts",
        "packages/*/test/**/*.ts",
        "tasks/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
